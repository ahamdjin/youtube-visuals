---
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  title: string;
  text: string;
  available?: boolean;
}

const { icon, title, text, available = true } = Astro.props;
---

<div class="feature-row">
  <span class:list={['status', { unavailable: !available }]} aria-hidden="true">
    {available ? '✓' : '×'}
  </span>

  <span class="feature-icon" aria-hidden="true">
    <Icon name={icon} />
  </span>

  <div class="feature-copy">
    <strong>{title}</strong>
    <span>{text}</span>
  </div>
</div>

<style>
  .feature-row {
    min-height: 72px;
    display: grid;
    grid-template-columns: 32px 42px 1fr;
    gap: 13px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #ececec;
  }

  .feature-row:last-child { border-bottom: 0; }

  .status {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid #d3d3d3;
    border-radius: 999px;
    color: #111;
    background: #fff;
    font-size: 17px;
    line-height: 1;
    font-weight: 850;
  }

  .status.unavailable { color: #919191; }

  .feature-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: #f6f6f6;
    color: #111;
  }

  .feature-icon :global(svg) {
    width: 21px;
    height: 21px;
    stroke-width: 1.8;
  }

  .feature-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: clamp(17px, 1.3vw, 21px);
    line-height: 1.25;
    letter-spacing: -.015em;
  }

  .feature-copy strong { font-weight: 780; }
  .feature-copy span { color: #666; }
</style>

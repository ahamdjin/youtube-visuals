---
import BaseLayout from '../layouts/BaseLayout.astro';
import { visuals } from '../data/visuals';
---

<BaseLayout title="YouTube Visuals" description="A library of simple HTML/CSS visuals for YouTube videos.">
  <main class="library">
    <header class="library-header">
      <p>Visual Library</p>
      <h1>YouTube Visuals</h1>
      <span>Simple, reusable HTML/CSS diagrams and comparison pages.</span>
    </header>

    <section class="grid">
      {visuals.map((visual, index) => (
        <a class="visual-card" href={`/visuals/${visual.slug}`}>
          <div class="card-top">
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <span class="category">{visual.category}</span>
          </div>
          <div>
            <h2>{visual.title}</h2>
            <p>{visual.description}</p>
          </div>
          <span class="open">Open visual →</span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .library {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 76px 0 90px;
  }

  .library-header {
    max-width: 780px;
    padding-bottom: 36px;
    border-bottom: 1px solid #e3e3e3;
  }

  .library-header p {
    margin: 0 0 12px;
    color: #7d7d7d;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .library-header h1 {
    margin: 0;
    font-size: clamp(54px, 7vw, 90px);
    line-height: .95;
    letter-spacing: -.06em;
  }

  .library-header span {
    display: block;
    margin-top: 18px;
    color: #707070;
    font-size: 20px;
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding-top: 32px;
  }

  .visual-card {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border: 1px solid #dedede;
    border-radius: 22px;
    color: #111;
    text-decoration: none;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  .visual-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 50px rgba(0,0,0,.07);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .number {
    color: #999;
    font-size: 14px;
    font-weight: 760;
  }

  .category {
    padding: 7px 10px;
    border: 1px solid #ddd;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 740;
  }

  h2 {
    margin: 0;
    font-size: 38px;
    line-height: 1;
    letter-spacing: -.04em;
  }

  .visual-card p {
    margin: 12px 0 0;
    max-width: 520px;
    color: #737373;
    font-size: 17px;
    line-height: 1.45;
  }

  .open {
    font-size: 15px;
    font-weight: 760;
  }

  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

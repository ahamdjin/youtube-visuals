---
import { Icon } from 'astro-icon/components';
import VisualLayout from '../../layouts/VisualLayout.astro';
import ComparisonCard from '../../components/ComparisonCard.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import BrandLogo from '../../components/BrandLogo.astro';

const hermesLogo = 'https://hermes-agent.nousresearch.com/favicon.ico';
---

<VisualLayout
  title="Managed Hermes vs VPS"
  description="Managed Hermes compared with running Hermes on your own VPS."
>
  <div class="visual-header">
    <div>
      <div class="brand-line">
        <BrandLogo src={hermesLogo} alt="Hermes Agent" size={32} />
        <span>Hermes Agent</span>
      </div>
      <p class="visual-kicker">Hosting comparison</p>
      <h1 class="visual-title">Managed or VPS?</h1>
    </div>

    <div class="header-note">
      <Icon name="lucide:server-cog" />
      <p>Same agent.<br /><strong>Different level of control.</strong></p>
    </div>
  </div>

  <div class="comparison-grid">
    <ComparisonCard
      title="Managed Hermes"
      description="Hostinger manages the server layer so you can focus on configuring and using Hermes."
      badge="Simpler"
      headerIcon="lucide:cloud"
      brandLogo={hermesLogo}
      brandAlt="Hermes Agent"
      bestFor="Speed & simplicity"
    >
      <FeatureRow
        icon="lucide:rocket"
        title="Fast guided setup"
        text="Get running from hPanel"
      />
      <FeatureRow
        icon="lucide:shield-check"
        title="Updates & core security"
        text="Handled for you"
      />
      <FeatureRow
        icon="lucide:square-terminal"
        title="Full CLI access"
        text="Inside the Hermes environment"
      />
      <FeatureRow
        icon="lucide:gauge"
        title="Less maintenance"
        text="Less server work day to day"
      />
      <FeatureRow
        icon="lucide:key-round"
        title="No root access"
        text="To the underlying host server"
        available={false}
      />
    </ComparisonCard>

    <ComparisonCard
      title="VPS Hermes"
      description="You run Hermes on your own VPS and control the server, tools, and surrounding environment."
      badge="More control"
      headerIcon="lucide:server"
      brandLogo={hermesLogo}
      brandAlt="Hermes Agent"
      bestFor="Power & flexibility"
    >
      <FeatureRow
        icon="lucide:key-round"
        title="Full server control"
        text="Root access to the VPS"
      />
      <FeatureRow
        icon="lucide:package-plus"
        title="Install your own tools"
        text="Docker, Codex CLI, custom services"
      />
      <FeatureRow
        icon="lucide:sliders-horizontal"
        title="More customization"
        text="Models, memory, tools, and config"
      />
      <FeatureRow
        icon="lucide:database"
        title="Your own infrastructure"
        text="For agent data and workloads"
      />
      <FeatureRow
        icon="lucide:wrench"
        title="You maintain it"
        text="Updates, backups, firewall, containers"
        available={false}
      />
    </ComparisonCard>
  </div>
</VisualLayout>

<style>
  .visual-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: clamp(25px, 2.3vw, 38px);
  }

  .brand-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-size: 16px;
    line-height: 1;
    font-weight: 780;
  }

  .header-note {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 4px;
    color: #777;
  }

  .header-note :global(svg) {
    width: 34px;
    height: 34px;
    color: #111;
    stroke-width: 1.5;
  }

  .header-note p {
    margin: 0;
    text-align: right;
    font-size: clamp(16px, 1.15vw, 20px);
    line-height: 1.35;
  }

  .header-note strong {
    color: #111;
    font-weight: 760;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 1.6vw, 26px);
    height: calc(100% - 170px);
  }

  @media (max-width: 980px) {
    .visual-header { align-items: start; }
    .header-note { display: none; }
    .comparison-grid {
      grid-template-columns: 1fr;
      height: auto;
    }
  }
</style>
